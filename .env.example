# ASP.NET Core Environment (Development or Production)
ASPNETCORE_ENVIRONMENT=Development

# SQL Server SA Password
SA_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# JWT Authentication
JWT_KEY=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS_LONG
JWT_ISSUER=TaskManagement.API
JWT_AUDIENCE=TaskManagement.Client
JWT_EXPIRE_DAYS=7

# Email Settings (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM_NAME=Task Management System

# Frontend Vite API URL (Browser URL accessible from client machine)
VITE_API_URL=http://localhost:8080/api
